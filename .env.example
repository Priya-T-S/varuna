# =====================================================================
# VARUNA AI — environment configuration template.
# Copy to `.env` (repo root and/or backend/) and fill in real values.
# The `.env` file is git-ignored; NEVER commit credentials.
# =====================================================================

# --- Application ---
ENVIRONMENT=development

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=varuna
POSTGRES_PASSWORD=varuna
POSTGRES_DB=varuna_ai

# --- Frontend ---
# Base URL of the backend API (leave empty in dev; Vite proxies /api).
VITE_API_URL=

# --- Satellite data sources (Phase 2) ---
# MOSDAC (https://mosdac.gov.in) — registered account required.
MOSDAC_API_USER=
MOSDAC_API_PASSWORD=
# NASA Earthdata (https://urs.earthdata.nasa.gov) — bearer token.
NASA_EARTHDATA_TOKEN=

# --- Application database ---
# Empty = local SQLite file backend/varuna.db (zero setup).
# USE_POSTGRES=true builds the URL from POSTGRES_* above; or give a full URL.
DATABASE_URL=
USE_POSTGRES=false

# --- What-if flood assistant (Claude) ---
# Optional. Without a key the chat runs in free offline mode: a rule-based
# assistant that answers from VARUNA's own simulator, SHAP drivers, village
# data and incident catalogue (English only, fixed answer layout).
# With a key (https://console.anthropic.com -> API keys) Claude answers instead.
# CHAT_PROVIDER: auto (Claude if key set, else offline) | offline | claude
CHAT_PROVIDER=auto
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=medium

# --- Real-time alerting ---
ALERTS_ENABLED=true
ALERT_SCAN_INTERVAL_MIN=15
ALERT_DEFAULT_MIN_LEVEL=high
ALERT_COOLDOWN_MIN=180
ALERT_VALIDITY_HOURS=24
# Used for the "Acknowledge" links inside messages. Must be reachable from the
# recipient's phone (e.g. an ngrok / cloudflared tunnel URL) for one-tap acks.
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:5173
SECRET_KEY=change-me-in-production

# Telegram (free): talk to @BotFather -> /newbot -> copy the token.
# Each officer opens the bot and presses Start; get their chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates . A group id (negative) works too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# E-mail (free with Gmail): Google Account -> Security -> 2-Step Verification ->
# App passwords -> create one, paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Twilio SMS + WhatsApp (free trial credit; WhatsApp sandbox is free):
# console.twilio.com -> Account SID / Auth Token. Trial SMS reach verified numbers only.
# WhatsApp sandbox sender is whatsapp:+14155238886; each recipient sends the join code once.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
